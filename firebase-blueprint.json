{
  "entities": {
    "License": {
      "title": "License",
      "description": "User license key and device locking authorization record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier"
        },
        "license_key": {
          "type": "string",
          "description": "Formatted license key"
        },
        "full_name": {
          "type": "string",
          "description": "Full name of the license owner"
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "amount": {
          "type": "string",
          "description": "Amount paid"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "blocked"],
          "description": "Approval status"
        },
        "duration_label": {
          "type": "string",
          "description": "Plan duration name"
        },
        "expires_at": {
          "type": "string",
          "description": "ISO timestamp for license expiration"
        },
        "lifetime": {
          "type": "boolean",
          "description": "Whether license has unlimited lifetime duration"
        },
        "max_devices": {
          "type": "number",
          "description": "Maximum number of allowed concurrent bound devices"
        },
        "license_devices": {
          "type": "array",
          "description": "Bound device IDs"
        },
        "created_at": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updated_at": {
          "type": "string",
          "description": "Last update timestamp"
        }
      },
      "required": ["license_key", "full_name", "status"]
    },
    "Signal": {
      "title": "Signal",
      "description": "AI-analyzed trading opportunity record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Signal ID code"
        },
        "pair": {
          "type": "string",
          "description": "Currency pair symbol"
        },
        "market": {
          "type": "string",
          "description": "Market type"
        },
        "timer": {
          "type": "string",
          "description": "Signal timeframe"
        },
        "mode": {
          "type": "string",
          "enum": ["live", "future"],
          "description": "Signal generation mode"
        },
        "direction": {
          "type": "string",
          "enum": ["BUY", "SELL"],
          "description": "Trade direction UP or DOWN"
        },
        "entry": {
          "type": "string",
          "description": "Entry ISO timestamp"
        },
        "expiry": {
          "type": "string",
          "description": "Expiry ISO timestamp"
        },
        "accuracy": {
          "type": "string",
          "description": "Calculated accuracy rate"
        },
        "strength": {
          "type": "string",
          "description": "Signal strength"
        },
        "created_at": {
          "type": "string",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "pair", "direction", "entry"]
    }
  },
  "firestore": {
    "/licenses/{licenseId}": {
      "schema": {
        "$ref": "#/entities/License"
      },
      "description": "Collection of user license keys and approvals"
    },
    "/signals/{signalId}": {
      "schema": {
        "$ref": "#/entities/Signal"
      },
      "description": "Collection of generated trading signals"
    }
  }
}
